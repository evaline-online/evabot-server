[Unit]
Description=EvaBot Brain Backend Compute Engine
After=network.target

[Service]
Type=simple
User=evabot
WorkingDirectory=/var/www/evabot-backend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node dist/server/server.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/evabot-brain.log
StandardError=append:/var/log/evabot-brain.error.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
